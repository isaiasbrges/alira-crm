generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
//
// Regra do sistema: toda tabela de negócio carrega organizationId, sem exceção.
// A uniformidade é proposital — é ela que permite ao guard de tenancy
// (src/lib/tenant/db.ts) aplicar o filtro sozinho, sem lista de exceções que
// alguém possa esquecer de atualizar ao criar um modelo novo.
//
// storeId aparece só onde o dado pertence a uma loja específica. Cadastros que
// a organização compartilha entre lojas (categorias, tags, usuários) ficam
// apenas com organizationId.
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ATIVA
  SUSPENSA
  CANCELADA
}

model Organization {
  id      String             @id @default(cuid())
  nome    String
  slug    String             @unique
  status  OrganizationStatus @default(ATIVA)
  /// Rótulo do plano contratado. Sem cobrança associada: existe para o painel
  /// master exibir e segmentar; billing é decisão de outra fase.
  plano   String?
  /// Marca a organização interna do time Alira, dona dos SUPER_ADMIN.
  interna Boolean            @default(false)

  /// URL do webhook n8n para onde mensagens digitadas aqui são retransmitidas
  /// (n8n encaminha para a Evolution API, que envia de fato pelo WhatsApp).
  n8nWebhookUrl String? @db.VarChar(500)
  /// Token que autentica o webhook inbound (n8n -> Alira): identifica a
  /// organização sem exigir sessão de usuário, já que quem chama é o n8n.
  whatsappWebhookToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores              Store[]
  users               User[]
  sellers             Seller[]
  customers           Customer[]
  customerPreferences CustomerPreference[]
  tags                Tag[]
  customerTags        CustomerTag[]
  categories          Category[]
  products            Product[]
  productVariants     ProductVariant[]
  sales               Sale[]
  saleItems           SaleItem[]
  exchanges           Exchange[]
  exchangeItems       ExchangeItem[]
  tasks               Task[]
  segments            Segment[]
  campaigns           Campaign[]
  campaignRecipients  CampaignRecipient[]
  whatsappMessages    WhatsappMessage[]
  consents            Consent[]
  suppressionEntries  SuppressionEntry[]
  activityLogs        ActivityLog[]
  storeAccess         StoreAccess[]

  @@map("organizations")
}

model Store {
  id             String  @id @default(cuid())
  organizationId String
  nome           String
  slug           String
  ativa          Boolean @default(true)
  /// Logo da loja. Guarda um data URI (upload direto, sem storage externo) ou uma URL.
  logoUrl        String? @db.LongText
  /// Hash da senha que trava a abertura do PDV desta loja. Nulo = PDV não pede senha.
  pdvSenhaHash   String? @db.VarChar(255)
  /// Cor de destaque da marca, em hex (#RRGGBB). Nulo = azul padrão do tema.
  corDestaque    String? @db.VarChar(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sellers      Seller[]
  customers    Customer[]
  products     Product[]
  sales        Sale[]
  tasks        Task[]
  segments     Segment[]
  campaigns    Campaign[]
  storeAccess  StoreAccess[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("stores")
}

/// Restringe quais lojas um usuário acessa. Ausência de linhas para um
/// usuário = sem restrição, acessa todas as lojas ativas da organização
/// (inclusive lojas criadas depois) — é o comportamento de sempre, preservado
/// pra quem ninguém restringiu explicitamente.
model StoreAccess {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  storeId        String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([organizationId])
  @@index([storeId])
  @@map("store_access")
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

enum UserRole {
  /// Time Alira. Enxerga o painel master; não é dono de nenhuma loja cliente.
  SUPER_ADMIN
  /// Dono da empresa cliente.
  OWNER
  /// Gerente de loja.
  MANAGER
  /// Vendedor.
  SELLER
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  nome           String
  email          String   @unique
  senhaHash      String
  role           UserRole @default(SELLER)
  ativo          Boolean  @default(true)

  /// Loja preenchida no último acesso, para reabrir o app onde o usuário parou.
  ultimaStoreId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seller       Seller?
  tasks        Task[]        @relation("TaskCriador")
  storeAccess  StoreAccess[]

  @@index([organizationId])
  @@map("users")
}

model Seller {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String
  userId         String? @unique
  nome           String
  ativo          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customers    Customer[]
  sales        Sale[]
  tasks        Task[]       @relation("TaskResponsavel")

  @@index([organizationId])
  @@index([storeId])
  @@map("sellers")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ATIVO
  INATIVO
  VIP
}

model Customer {
  id             String @id @default(cuid())
  organizationId String
  storeId        String

  nome       String
  whatsapp   String
  email      String?
  nascimento DateTime?
  cidade     String?
  estado     String?   @db.VarChar(2)

  sellerId String?
  status   CustomerStatus @default(ATIVO)

  // Consentimento vigente para campanhas de marketing (detalhe fica em Consent).
  consentimentoWhatsapp Boolean @default(false)
  /// Atendimento (thread de WhatsApp) marcado como resolvido. Só existe uma
  /// thread por cliente hoje — quando houver disparo real, isso pode virar
  /// uma entidade própria.
  atendimentoResolvido  Boolean @default(false)

  // Agregados desnormalizados, recalculados a cada venda para leitura barata.
  ultimaCompra DateTime?
  totalGasto   Decimal   @default(0) @db.Decimal(10, 2)
  ticketMedio  Decimal   @default(0) @db.Decimal(10, 2)
  totalCompras Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  seller       Seller?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  preferences  CustomerPreference?
  tags         CustomerTag[]
  sales        Sale[]
  exchanges    Exchange[]
  tasks        Task[]
  recipients   CampaignRecipient[]
  messages     WhatsappMessage[]
  consents     Consent[]

  // O whatsapp identifica o cliente dentro da organização, não globalmente:
  // o mesmo número pode ser cliente de duas empresas diferentes.
  @@unique([organizationId, whatsapp])
  @@index([organizationId, storeId])
  @@index([organizationId, status])
  @@map("customers")
}

model CustomerPreference {
  id             String @id @default(cuid())
  organizationId String
  customerId     String @unique

  tamanhoCamiseta String?
  tamanhoCalca    String?
  tamanhoCalcado  String?

  estilo              String?
  // Listas curtas de texto livre; JSON evita tabelas auxiliares no MVP.
  cores               Json?
  marcas              Json?
  categoriasFavoritas Json?
  observacoes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("customer_preferences")
}

model Tag {
  id             String  @id @default(cuid())
  organizationId String
  label          String
  cor            String?

  createdAt DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    CustomerTag[]

  @@unique([organizationId, label])
  @@map("tags")
}

model CustomerTag {
  organizationId String
  customerId     String
  tagId          String

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([organizationId])
  @@index([tagId])
  @@map("customer_tags")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Category {
  id             String @id @default(cuid())
  organizationId String
  nome           String
  slug           String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, slug])
  @@map("categories")
}

enum ProductStatus {
  ATIVO
  INATIVO
  ARQUIVADO
}

model Product {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String
  categoryId     String?

  nome    String
  sku     String
  colecao String?
  preco   Decimal       @db.Decimal(10, 2)
  status  ProductStatus @default(ATIVO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]

  @@unique([organizationId, sku])
  @@index([organizationId, storeId])
  @@index([organizationId, status])
  @@map("products")
}

model ProductVariant {
  id             String @id @default(cuid())
  organizationId String
  productId      String

  sku     String
  tamanho String
  cor     String
  // Sobrescreve o preço do produto quando a variante custa diferente.
  preco   Decimal? @db.Decimal(10, 2)
  estoque Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]
  exchanges    ExchangeItem[]

  @@unique([productId, tamanho, cor])
  // SKU único por organização, nunca global: duas empresas podem usar o mesmo
  // código de peça sem uma bloquear o cadastro da outra.
  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Vendas
// ---------------------------------------------------------------------------

enum SaleStatus {
  RASCUNHO
  CONCLUIDA
  CANCELADA
}

enum PaymentMethod {
  DINHEIRO
  PIX
  DEBITO
  CREDITO
  CREDIARIO
  OUTRO
}

model Sale {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String
  customerId     String?
  sellerId       String?

  numero         Int
  status         SaleStatus     @default(RASCUNHO)
  subtotal       Decimal        @default(0) @db.Decimal(10, 2)
  desconto       Decimal        @default(0) @db.Decimal(10, 2)
  total          Decimal        @default(0) @db.Decimal(10, 2)
  formaPagamento PaymentMethod?
  observacao     String?        @db.Text

  // Preenchido quando a venda é atribuída a uma campanha (receita originada).
  campaignId String?

  concluidaEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller       Seller?      @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items        SaleItem[]
  exchanges    Exchange[]

  @@unique([storeId, numero])
  @@index([organizationId, storeId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([campaignId])
  @@map("sales")
}

model SaleItem {
  id             String @id @default(cuid())
  organizationId String
  saleId         String
  variantId      String

  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  desconto      Decimal @default(0) @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([saleId])
  @@index([variantId])
  @@map("sale_items")
}

enum ExchangeStatus {
  ABERTA
  CONCLUIDA
  CANCELADA
}

model Exchange {
  id             String  @id @default(cuid())
  organizationId String
  saleId         String
  customerId     String?

  status    ExchangeStatus @default(ABERTA)
  motivo    String?        @db.Text
  diferenca Decimal        @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        ExchangeItem[]

  @@index([organizationId])
  @@index([saleId])
  @@map("exchanges")
}

model ExchangeItem {
  id             String @id @default(cuid())
  organizationId String
  exchangeId     String
  variantId      String

  quantidade Int
  devolucao  Boolean @default(true)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  exchange     Exchange       @relation(fields: [exchangeId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([exchangeId])
  @@map("exchange_items")
}

// ---------------------------------------------------------------------------
// Relacionamento
// ---------------------------------------------------------------------------

enum TaskStatus {
  PENDENTE
  CONCLUIDA
  CANCELADA
}

enum TaskPriority {
  ALTA
  MEDIA
  BAIXA
}

model Task {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String
  customerId     String?
  sellerId       String?
  criadoPorId    String?

  titulo     String
  descricao  String?      @db.Text
  status     TaskStatus   @default(PENDENTE)
  prioridade TaskPriority @default(MEDIA)
  venceEm    DateTime?

  concluidaEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller       Seller?      @relation("TaskResponsavel", fields: [sellerId], references: [id], onDelete: SetNull)
  criadoPor    User?        @relation("TaskCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([organizationId, storeId])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("tasks")
}

/// Segmento salvo — o conjunto de regras, não a lista de clientes.
/// A lista é resolvida na hora do uso, para nunca ficar defasada.
model Segment {
  id             String  @id @default(cuid())
  organizationId String
  /// Nulo quando o segmento vale para todas as lojas da organização.
  storeId        String?

  nome      String
  descricao String? @db.Text
  /// Árvore de condições com AND/OR. O construtor visual chega em fase futura;
  /// o formato fica aqui para não travar o schema quando ele chegar.
  regras    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]

  @@index([organizationId])
  @@index([storeId])
  @@map("segments")
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  ENVIANDO
  ENVIADA
  PAUSADA
  CANCELADA
}

model Campaign {
  id             String  @id @default(cuid())
  organizationId String
  storeId        String
  segmentId      String?

  nome           String
  status         CampaignStatus @default(RASCUNHO)
  templateNome   String?
  /// Cópia das regras no momento do disparo. Preserva o histórico mesmo que o
  /// segmento de origem seja editado depois.
  segmentoRegras Json?
  agendadaPara   DateTime?
  enviadaEm      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  segment      Segment?            @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  recipients   CampaignRecipient[]
  messages     WhatsappMessage[]
  sales        Sale[]

  @@index([organizationId, storeId])
  @@index([organizationId, status])
  @@map("campaigns")
}

enum RecipientStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
  OPT_OUT
}

model CampaignRecipient {
  id             String @id @default(cuid())
  organizationId String
  campaignId     String
  customerId     String

  status RecipientStatus @default(QUEUED)
  erro   String?         @db.Text

  enviadoEm    DateTime?
  entregueEm   DateTime?
  lidoEm       DateTime?
  respondidoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages     WhatsappMessage[]

  @@unique([campaignId, customerId])
  @@index([organizationId])
  @@index([status])
  @@map("campaign_recipients")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model WhatsappMessage {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String?
  campaignId     String?
  recipientId    String?

  direction  MessageDirection
  // ID da mensagem na Meta Cloud API, usado para casar webhooks de status.
  externalId String?          @unique
  template   String?
  corpo      String?          @db.Text
  status     RecipientStatus?
  erro       String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign     Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recipient    CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
  @@index([campaignId])
  @@map("whatsapp_messages")
}

// ---------------------------------------------------------------------------
// LGPD
// ---------------------------------------------------------------------------

enum ConsentChannel {
  WHATSAPP
  EMAIL
  SMS
}

model Consent {
  id             String @id @default(cuid())
  organizationId String
  customerId     String

  canal       ConsentChannel @default(WHATSAPP)
  concedido   Boolean
  origem      String?
  versaoTexto String?
  ip          String?        @db.VarChar(45)
  concedidoEm DateTime?
  revogadoEm  DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId, canal])
  @@map("consents")
}

/// Bloqueio definitivo — quem está aqui nunca entra em campanha de marketing.
/// O bloqueio vale dentro da organização: sair da lista de uma empresa não
/// afeta as outras.
model SuppressionEntry {
  id             String  @id @default(cuid())
  organizationId String
  whatsapp       String
  motivo         String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, whatsapp])
  @@map("suppression_list")
}

model ActivityLog {
  id             String @id @default(cuid())
  organizationId String

  entidade   String
  entidadeId String
  acao       String
  autorId    String?
  payload    Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entidade, entidadeId])
  @@map("activity_logs")
}
