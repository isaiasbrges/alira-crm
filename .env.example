# Banco de dados (MySQL)
DATABASE_URL="mysql://usuario:senha@localhost:3306/alira_crm"

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:4310"

# Assina o cookie de sessão do login. Gere um valor forte e não reaproveite
# entre ambientes: `openssl rand -hex 32`.
SESSION_SECRET=

# Meta WhatsApp Cloud API (necessário apenas quando o módulo WhatsApp entrar)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_VERIFY_TOKEN=

# OpenAI (opcional, para recursos de IA futuros)
OPENAI_API_KEY=
